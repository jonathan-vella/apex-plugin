{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "apex-azure-pricing": {
      "type": "http",
      "url": "https://mcp.management.azure.com",
      "headers": {
        "x-mcp-toolset": "CostManagement, Pricing"
      }
    },
    "apex": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/mcp/apex.mjs"]
    },
    "apex-azure-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@azure/mcp@2.0.5", "server", "start"],
      "env": {
        "NPM_CONFIG_ALLOW_REMOTE": "all"
      }
    }
  }
}
