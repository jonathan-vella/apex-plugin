{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "apex-spike": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/mcp/server.mjs"]
    },
    "apex-spike-azure": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@azure/mcp@2.0.5", "server", "start"]
    }
  }
}
